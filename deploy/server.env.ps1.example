# Kopie als deploy\server.env.ps1 anlegen (git-ignoriert) und Werte anpassen.
# Wird von start_server.ps1, start_ngrok.ps1 und update_and_restart.ps1 geladen.

# Notfall-Verhalten wie die Notfall-exe (Datei-Login, eigener Schluessel, kein Update-Hinweis)
$env:NOTENAPP_NOTFALL = "1"

# Datenordner: instance\app.db, secret_key, dateilogin.key, admin_passwort.txt, backups\
# Fester Pfad, weil der Dienst als SYSTEM laeuft und kein eigenes LOCALAPPDATA hat.
$env:NOTENAPP_DATA_DIR = "C:\NotenAppDaten"

# Server-Ablage: Admins speichern ihre Sammlung verschluesselt hier auf dem Server
# (mit automatischem Speichern). Nur fuer diesen selbst betriebenen Notfallserver gedacht.
$env:NOTENAPP_SERVER_ABLAGE = "1"

$env:NOTENAPP_HOST = "0.0.0.0"
$env:NOTENAPP_PORT = "5000"

# ngrok: feste Domain und Konfigurationsdatei mit Authtoken
# (unter SYSTEM wird die ngrok.yml aus dem Benutzerprofil NICHT gefunden).
$env:NGROK_DOMAIN = "enzyme-cognitive-nearly.ngrok-free.dev"
$env:NGROK_CONFIG = "C:\NotenAppDaten\ngrok.yml"
# Adresse fuer Zugangslinks; Standard: https://<NGROK_DOMAIN>
# $env:PUBLIC_BASE_URL = "https://enzyme-cognitive-nearly.ngrok-free.dev"
# $env:NGROK_EXE = "C:\NotenAppWeb\ngrok.exe"   # Standard: ngrok.exe im Repo

# Optional: Anmelden mit Notendatei mit dem Landkreis-Schluessel (sonst dateilogin.key im Datenordner)
# $env:FILE_LOGIN_KEY = "..."

# Optional: zusaetzliches Sicherungsziel (UNC-Pfad, Netzlaufwerke sind unter SYSTEM nicht verbunden)
# $env:SICHERUNG_ZIEL = "\nas\notenapp-sicherung"
